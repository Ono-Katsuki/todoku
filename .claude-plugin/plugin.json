{
  "name": "todoku",
  "description": "申請書類（Excel・Word・PDF・一太郎など）を、AI エージェントが正確に読み書きできるようにする。書いた所のほかは変わっていないことを書類ごとに証明する",
  "author": {
    "name": "Ono Katsuki"
  },
  "repository": "https://github.com/Ono-Katsuki/todoku",
  "keywords": [
    "申請書",
    "様式",
    "アクセシビリティ",
    "Excel",
    "PDF",
    "Word",
    "一太郎"
  ],
  "mcpServers": {
    "todoku": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--no-dev",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "todoku-mcp"
      ]
    }
  },
  "license": "Apache-2.0"
}
